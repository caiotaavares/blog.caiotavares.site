<style>
    .footer {
        width: 100%;
        margin-top: auto;
        background-color: var(--redBGColor);
        color: black;
        padding: 2em 0;
    }

    .footer h3 {
        font-weight: bold;
    }

    .footer-content {
        display: flex;
        justify-content: space-between;
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 20px;
        flex-wrap: wrap;
        gap: 30px;
    }

    .footer-column {
        flex: 1;
        min-width: 200px;
    }

    .footer-column a {
        text-decoration: none;
        color: black;
        margin-bottom: 2px;
        font-size: 13px;
    }

    .footer-column h3 {
        margin-bottom: 1em;
        font-size: 13px;
        color: #fff;
    }

    .footer-column p {
        font-size: 13px;
        margin-bottom: 0.5em;
    }

    .footer-column ul {
        list-style-type: none;
        font-size: 13px;
        padding: 0;
    }

    @media (max-width: 768px) {
        .footer-content {
            flex-direction: column;
            gap: 30px;
            text-align: center;
        }

        .footer-column {
            min-width: 100%;
        }
    }
</style>

